# ============================================================
# Data
# ============================================================

# Raw datasets can become very large.
# Keep metadata / small CSV files in Git,
# but do not commit downloaded bulk datasets.

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/external/*
!data/external/.gitkeep


